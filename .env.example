# Copy this file to .env and fill in real values. .env is gitignored -
# never commit real credentials.

# IP address or hostname of the library's management interface.
MSL4048_HOST=

# Password for MSL4048_PRIVILEGE_LEVEL.
MSL4048_PASSWORD=

# user | administrator | service. Power control requires administrator or higher.
MSL4048_PRIVILEGE_LEVEL=administrator

# Comma list of name=slot pairs, e.g. drive1=1,drive2=2
MSL4048_DRIVES=drive1=1

# Optional. The library only allows one logged-in session at a time, so the
# CLI takes a lock before logging in. Leave unset to use an automatic
# per-host path under the OS temp directory - only set this if more than
# one machine needs to talk to the same library, in which case point every
# machine at the same shared/UNC path.
#MSL4048_LOCK_FILE=

# Optional, used only by scripts/tape-power.bat (not the CLI itself). Set
# to 1 to have tape-power.bat also run refresh-veeam-tape.ps1 after a
# successful power-on, so Veeam re-detects the drive instead of showing it
# offline until the next manual rescan. Test refresh-veeam-tape.ps1
# manually first - see its header comment.
#MSL4048_VEEAM_REFRESH=1
